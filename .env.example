# Database (Neon Postgres)
DATABASE_URL="postgresql://user:pass@host/plunj?sslmode=require"

# Stripe (platform account; per-location connected accounts stored in DB)
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# Better Auth
BETTER_AUTH_SECRET="generate-with: openssl rand -base64 32"
# Origin ONLY — no path. Next strips the /book basePath before route handlers
# run, so a path-bearing value 404s every auth route.
BETTER_AUTH_URL="http://localhost:3000"

# Twilio (SMS OTP + notifications)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_VERIFY_SERVICE_SID=""
TWILIO_FROM_NUMBER=""

# Resend (email receipts)
RESEND_API_KEY=""

# Pilot SMS bridge (until the Twilio number clears carrier registration):
# when set alongside RESEND_API_KEY (and Twilio vars are absent), every
# outbound SMS is emailed to this inbox instead of texted.
SMS_FALLBACK_EMAIL=""
# From-address override; use "onboarding@resend.dev" before plunj.co is verified in Resend.
RESEND_FROM=""
