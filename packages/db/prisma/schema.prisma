// PLUNJ booking platform — Prisma schema (Phase 1–3 entity model)
//
// Conventions:
// - ids are UUIDv7 strings generated in app code via the `id()` helper in src/index.ts
// - all money fields are integer cents (suffix `Cents`); basis points use suffix `Bps`
// - every tenant-scoped model carries a denormalized, indexed `locationId`
// - snake_case table/column names via @@map/@map, camelCase Prisma fields
// - DB-level constraints Prisma can't express live in prisma/sql/constraints.sql

generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  runtime                = "nodejs"
  moduleFormat           = "esm"
  generatedFileExtension = "ts"
  importFileExtension    = "js"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum LocationStatus {
  COMING_SOON
  ACTIVE
  CLOSED
}

enum BookingProvider {
  INTERNAL
  MOMENCE
}

enum StudioKind {
  CONTRAST_SUITE
  MOBILE_SAUNA
}

enum OfferingType {
  COMMUNAL
  PRIVATE_ONLY
  BOTH
}

enum SessionStatus {
  OPEN
  CLOSED
  CANCELLED
  EXCLUSIVE
}

enum CustomerKind {
  GUEST
  ACCOUNT
}

enum WaiverKind {
  LIABILITY
  MINOR_CONSENT
  PRIVACY
}

enum SignatureKind {
  TYPED
  DRAWN
}

enum BookingType {
  DROP_IN
  BUYOUT
  MEMBER_VISIT
  PACK_VISIT
  COMP
}

enum BookingStatus {
  HOLD
  CONFIRMED
  CHECKED_IN
  CANCELLED
  NO_SHOW
  EXPIRED
}

enum OrderChannel {
  WEB
  POS
  ADMIN
}

enum OrderStatus {
  PENDING
  PAID
  PARTIALLY_REFUNDED
  REFUNDED
  VOID
}

enum OrderLineKind {
  DROP_IN
  BUYOUT
  MEMBERSHIP_CYCLE
  PACK
  GIFT_CARD
  RETAIL
  FEE
}

enum PaymentProviderKind {
  STRIPE
  INTERNAL
}

enum PaymentTender {
  CARD
  APPLE_PAY
  GOOGLE_PAY
  TERMINAL
  GIFT_CARD
  PACK_CREDIT
  ACCOUNT_CREDIT
  COMP
  CASH_RECORDED
}

enum PaymentStatus {
  REQUIRES_ACTION
  SUCCEEDED
  FAILED
  CANCELLED
}

enum RefundStatus {
  PENDING
  SUCCEEDED
  FAILED
}

enum DiscountType {
  PERCENT
  FIXED_CENTS
}

enum DiscountAppliesTo {
  ALL
  DROP_IN
  BUYOUT
  MEMBERSHIP_FIRST_CYCLE
  PACK
}

enum BillingInterval {
  MONTH
}

enum VisitPolicy {
  UNLIMITED
  N_PER_PERIOD
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  PAUSED
  CANCELLED
}

enum InvoiceStatus {
  PENDING
  PAID
  FAILED
  ABANDONED
}

enum GiftCardStatus {
  ACTIVE
  DISABLED
}

enum LedgerReason {
  PURCHASE
  REDEMPTION
  REFUND
  IMPORT
  ADJUSTMENT
  CANCELLATION_CREDIT
}

enum StaffRoleKind {
  CORPORATE_ADMIN
  LOCATION_OWNER
  LOCATION_ADMIN
  FRONT_DESK
}

enum ActorType {
  STAFF
  CUSTOMER
  SYSTEM
  WEBHOOK
}

enum WebhookStatus {
  RECEIVED
  PROCESSED
  FAILED
}

enum OutboxKind {
  SMS
  EMAIL
}

enum OutboxStatus {
  PENDING
  SENT
  FAILED
}

// ---------------------------------------------------------------------------
// Org & locations
// ---------------------------------------------------------------------------

model Organization {
  id        String   @id
  name      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  locations Location[]

  @@map("organizations")
}

model Location {
  id                String          @id
  orgId             String          @map("org_id")
  slug              String          @unique
  name              String
  /// IANA timezone, e.g. "America/Denver"
  timezone          String
  address1          String
  address2          String?
  city              String
  state             String
  postalCode        String          @map("postal_code")
  phone             String
  email             String
  status            LocationStatus  @default(COMING_SOON)
  taxRateBps        Int             @map("tax_rate_bps")
  bookingWindowDays Int             @default(35) @map("booking_window_days")
  bookingProvider   BookingProvider @default(MOMENCE) @map("booking_provider")
  momenceUrl        String?         @map("momence_url")
  settings          Json            @default("{}")
  stripeAccountId   String?         @map("stripe_account_id")
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")

  organization         Organization              @relation(fields: [orgId], references: [id])
  studios              Studio[]
  sessionTemplates     SessionTemplate[]
  sessions             Session[]
  buyoutOptions        BuyoutOption[]
  customerProfiles     CustomerLocationProfile[]
  waiverDocuments      WaiverDocument[]
  waiverSignatures     WaiverSignature[]
  bookings             Booking[]
  orders               Order[]
  orderLines           OrderLine[]
  payments             Payment[]
  refunds              Refund[]
  discountCodes        DiscountCode[]
  discountRedemptions  DiscountRedemption[]
  membershipPlans      MembershipPlan[]
  subscriptions        MembershipSubscription[]
  subscriptionInvoices SubscriptionInvoice[]
  giftCards            GiftCard[]
  packs                Pack[]
  packBalances         PackBalance[]
  storedValueEntries   StoredValueLedger[]
  staffRoles           StaffRole[]

  @@index([orgId])
  @@map("locations")
}

// ---------------------------------------------------------------------------
// Studios, schedule templates & sessions
// ---------------------------------------------------------------------------

model Studio {
  id              String     @id
  locationId      String     @map("location_id")
  name            String
  kind            StudioKind
  defaultCapacity Int        @map("default_capacity")
  active          Boolean    @default(true)
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")

  location         Location          @relation(fields: [locationId], references: [id])
  sessionTemplates SessionTemplate[]
  sessions         Session[]
  buyoutOptions    BuyoutOption[]
  bookings         Booking[]

  @@index([locationId])
  @@map("studios")
}

model SessionTemplate {
  id             String       @id
  studioId       String       @map("studio_id")
  locationId     String       @map("location_id")
  /// 0 = Sunday … 6 = Saturday
  dayOfWeek      Int          @map("day_of_week")
  /// Local wall time "HH:MM" in the location's IANA timezone; converted per-date to UTC at generation
  startTimeLocal String       @map("start_time_local")
  durationMin    Int          @default(60) @map("duration_min")
  /// null = studio.defaultCapacity
  capacity       Int?
  offeringType   OfferingType @map("offering_type")
  priceCents     Int          @map("price_cents")
  effectiveFrom  DateTime     @map("effective_from") @db.Date
  effectiveUntil DateTime?    @map("effective_until") @db.Date
  active         Boolean      @default(true)
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  studio   Studio    @relation(fields: [studioId], references: [id])
  location Location  @relation(fields: [locationId], references: [id])
  sessions Session[]

  @@unique([studioId, dayOfWeek, startTimeLocal, effectiveFrom])
  @@index([locationId])
  @@map("session_templates")
}

model Session {
  id                 String        @id
  studioId           String        @map("studio_id")
  locationId         String        @map("location_id")
  templateId         String?       @map("template_id")
  startsAt           DateTime      @map("starts_at")
  endsAt             DateTime      @map("ends_at")
  capacity           Int
  bookedSeats        Int           @default(0) @map("booked_seats")
  status             SessionStatus @default(OPEN)
  /// Set when a buyout Booking makes this session EXCLUSIVE. Intentionally not a FK:
  /// buyout writes flip many session rows atomically and must never dangle-block deletes.
  exclusiveBookingId String?       @map("exclusive_booking_id")
  priceCents         Int           @map("price_cents")
  createdAt          DateTime      @default(now()) @map("created_at")
  updatedAt          DateTime      @updatedAt @map("updated_at")

  studio   Studio           @relation(fields: [studioId], references: [id])
  location Location         @relation(fields: [locationId], references: [id])
  template SessionTemplate? @relation(fields: [templateId], references: [id])
  bookings Booking[]

  @@unique([studioId, startsAt])
  @@index([locationId, startsAt])
  @@index([templateId])
  @@map("sessions")
}

model BuyoutOption {
  id            String   @id
  locationId    String   @map("location_id")
  /// null = any studio at the location
  studioId      String?  @map("studio_id")
  durationHours Int      @map("duration_hours")
  priceCents    Int      @map("price_cents")
  maxGuests     Int      @map("max_guests")
  active        Boolean  @default(true)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  location Location @relation(fields: [locationId], references: [id])
  studio   Studio?  @relation(fields: [studioId], references: [id])

  @@index([locationId])
  @@map("buyout_options")
}

// ---------------------------------------------------------------------------
// Customers & waivers
// ---------------------------------------------------------------------------

model Customer {
  id               String       @id
  kind             CustomerKind
  firstName        String       @map("first_name")
  lastName         String?      @map("last_name")
  /// E.164, e.g. "+13854526505"
  phone            String
  email            String?
  dateOfBirth      DateTime?    @map("date_of_birth") @db.Date
  authUserId       String?      @unique @map("auth_user_id")
  stripeCustomerId String?      @map("stripe_customer_id")
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")

  locationProfiles    CustomerLocationProfile[]
  waiverSignatures    WaiverSignature[]         @relation("SignerWaiverSignatures")
  minorSignatures     WaiverSignature[]         @relation("MinorWaiverSignatures")
  bookings            Booking[]
  orders              Order[]
  discountRedemptions DiscountRedemption[]
  subscriptions       MembershipSubscription[]  @relation("CustomerSubscriptions")
  giftedSubscriptions MembershipSubscription[]  @relation("GiftedSubscriptions")
  purchasedGiftCards  GiftCard[]
  packBalances        PackBalance[]
  storedValueEntries  StoredValueLedger[]

  @@index([phone])
  @@map("customers")
}

model CustomerLocationProfile {
  id           String    @id
  customerId   String    @map("customer_id")
  locationId   String    @map("location_id")
  firstVisitAt DateTime? @map("first_visit_at")
  notes        String?
  flags        Json      @default("{}")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  customer Customer @relation(fields: [customerId], references: [id])
  location Location @relation(fields: [locationId], references: [id])

  @@unique([customerId, locationId])
  @@index([locationId])
  @@map("customer_location_profiles")
}

model WaiverDocument {
  id            String     @id
  locationId    String     @map("location_id")
  kind          WaiverKind
  version       Int
  title         String
  bodyMarkdown  String     @map("body_markdown")
  contentSha256 String     @map("content_sha256")
  publishedAt   DateTime?  @map("published_at")
  active        Boolean    @default(true)
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @updatedAt @map("updated_at")

  location   Location          @relation(fields: [locationId], references: [id])
  signatures WaiverSignature[]

  @@unique([locationId, kind, version])
  @@index([locationId])
  @@map("waiver_documents")
}

model WaiverSignature {
  id                   String        @id
  customerId           String        @map("customer_id")
  locationId           String        @map("location_id")
  waiverDocumentId     String        @map("waiver_document_id")
  signedAt             DateTime      @map("signed_at")
  signatureKind        SignatureKind @map("signature_kind")
  typedName            String?       @map("typed_name")
  signatureImageUrl    String?       @map("signature_image_url")
  ipAddress            String?       @map("ip_address")
  userAgent            String?       @map("user_agent")
  /// Set when a guardian signs on behalf of a minor
  minorCustomerId      String?       @map("minor_customer_id")
  guardianName         String?       @map("guardian_name")
  guardianRelationship String?       @map("guardian_relationship")
  createdAt            DateTime      @default(now()) @map("created_at")
  updatedAt            DateTime      @updatedAt @map("updated_at")

  customer       Customer       @relation("SignerWaiverSignatures", fields: [customerId], references: [id])
  location       Location       @relation(fields: [locationId], references: [id])
  waiverDocument WaiverDocument @relation(fields: [waiverDocumentId], references: [id])
  minorCustomer  Customer?      @relation("MinorWaiverSignatures", fields: [minorCustomerId], references: [id])

  @@index([customerId])
  @@index([locationId])
  @@index([waiverDocumentId])
  @@map("waiver_signatures")
}

// ---------------------------------------------------------------------------
// Bookings
// ---------------------------------------------------------------------------

model Booking {
  id                 String        @id
  /// null for buyouts spanning multiple sessions
  sessionId          String?       @map("session_id")
  locationId         String        @map("location_id")
  studioId           String        @map("studio_id")
  customerId         String        @map("customer_id")
  orderId            String?       @map("order_id")
  type               BookingType
  seats              Int           @default(1)
  status             BookingStatus
  holdExpiresAt      DateTime?     @map("hold_expires_at")
  startsAt           DateTime      @map("starts_at")
  endsAt             DateTime      @map("ends_at")
  attendees          Json          @default("[]")
  cancelledAt        DateTime?     @map("cancelled_at")
  cancellationReason String?       @map("cancellation_reason")
  checkedInAt        DateTime?     @map("checked_in_at")
  manageToken        String        @unique @map("manage_token")
  createdAt          DateTime      @default(now()) @map("created_at")
  updatedAt          DateTime      @updatedAt @map("updated_at")

  session  Session? @relation(fields: [sessionId], references: [id])
  location Location @relation(fields: [locationId], references: [id])
  studio   Studio   @relation(fields: [studioId], references: [id])
  customer Customer @relation(fields: [customerId], references: [id])
  order    Order?   @relation(fields: [orderId], references: [id])

  @@index([locationId, startsAt])
  @@index([sessionId])
  @@index([studioId])
  @@index([customerId])
  @@index([orderId])
  @@index([status, holdExpiresAt])
  @@map("bookings")
}

// ---------------------------------------------------------------------------
// Orders & payments
// ---------------------------------------------------------------------------

model Order {
  id             String       @id
  locationId     String       @map("location_id")
  customerId     String?      @map("customer_id")
  channel        OrderChannel
  status         OrderStatus  @default(PENDING)
  currency       String       @default("usd")
  subtotalCents  Int          @map("subtotal_cents")
  discountCents  Int          @map("discount_cents")
  taxCents       Int          @map("tax_cents")
  tipCents       Int          @map("tip_cents")
  totalCents     Int          @map("total_cents")
  discountCodeId String?      @map("discount_code_id")
  /// Version tag of the pricing kernel that computed this order's totals
  pricingVersion String       @map("pricing_version")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  location             Location              @relation(fields: [locationId], references: [id])
  customer             Customer?             @relation(fields: [customerId], references: [id])
  discountCode         DiscountCode?         @relation(fields: [discountCodeId], references: [id])
  lines                OrderLine[]
  payments             Payment[]
  refunds              Refund[]
  bookings             Booking[]
  discountRedemptions  DiscountRedemption[]
  subscriptionInvoices SubscriptionInvoice[]
  storedValueEntries   StoredValueLedger[]

  @@index([locationId])
  @@index([customerId])
  @@index([discountCodeId])
  @@map("orders")
}

model OrderLine {
  id                     String        @id
  orderId                String        @map("order_id")
  locationId             String        @map("location_id")
  kind                   OrderLineKind
  /// Polymorphic reference (sessionId, buyoutOptionId, planId, packId, giftCardId…) per kind
  refId                  String?       @map("ref_id")
  description            String
  qty                    Int
  unitPriceCents         Int           @map("unit_price_cents")
  lineSubtotalCents      Int           @map("line_subtotal_cents")
  discountAllocatedCents Int           @map("discount_allocated_cents")
  taxCents               Int           @map("tax_cents")
  lineTotalCents         Int           @map("line_total_cents")
  taxable                Boolean
  createdAt              DateTime      @default(now()) @map("created_at")
  updatedAt              DateTime      @updatedAt @map("updated_at")

  order    Order    @relation(fields: [orderId], references: [id])
  location Location @relation(fields: [locationId], references: [id])

  @@index([orderId])
  @@index([locationId])
  @@map("order_lines")
}

model Payment {
  id                 String              @id
  orderId            String              @map("order_id")
  locationId         String              @map("location_id")
  provider           PaymentProviderKind
  /// e.g. Stripe connected account id the charge ran on
  providerAccountRef String?             @map("provider_account_ref")
  /// e.g. Stripe PaymentIntent id
  providerPaymentRef String?             @map("provider_payment_ref")
  tender             PaymentTender
  amountCents        Int                 @map("amount_cents")
  status             PaymentStatus
  failureCode        String?             @map("failure_code")
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")

  order    Order    @relation(fields: [orderId], references: [id])
  location Location @relation(fields: [locationId], references: [id])
  refunds  Refund[]

  @@index([orderId])
  @@index([locationId])
  @@index([providerPaymentRef])
  @@map("payments")
}

model Refund {
  id                 String       @id
  paymentId          String       @map("payment_id")
  orderId            String       @map("order_id")
  locationId         String       @map("location_id")
  amountCents        Int          @map("amount_cents")
  reason             String
  initiatedByStaffId String?      @map("initiated_by_staff_id")
  providerRefundRef  String?      @map("provider_refund_ref")
  status             RefundStatus @default(PENDING)
  /// Per-order-line allocation of the refunded amount, [{ orderLineId, amountCents }]
  lineAllocations    Json         @map("line_allocations")
  createdAt          DateTime     @default(now()) @map("created_at")
  updatedAt          DateTime     @updatedAt @map("updated_at")

  payment            Payment             @relation(fields: [paymentId], references: [id])
  order              Order               @relation(fields: [orderId], references: [id])
  location           Location            @relation(fields: [locationId], references: [id])
  initiatedByStaff   StaffUser?          @relation(fields: [initiatedByStaffId], references: [id])
  storedValueEntries StoredValueLedger[]

  @@index([paymentId])
  @@index([orderId])
  @@index([locationId])
  @@map("refunds")
}

// ---------------------------------------------------------------------------
// Discounts
// ---------------------------------------------------------------------------

model DiscountCode {
  id               String            @id
  /// null = brand-wide code valid at every location. Postgres treats NULLs as
  /// distinct in unique constraints, so uniqueness for brand-wide codes is
  /// enforced by a partial unique index in prisma/sql/constraints.sql.
  locationId       String?           @map("location_id")
  code             String
  type             DiscountType
  /// Required when type = PERCENT
  valueBps         Int?              @map("value_bps")
  /// Required when type = FIXED_CENTS
  valueCents       Int?              @map("value_cents")
  appliesTo        DiscountAppliesTo @map("applies_to")
  maxRedemptions   Int?              @map("max_redemptions")
  maxPerCustomer   Int?              @map("max_per_customer")
  minSubtotalCents Int?              @map("min_subtotal_cents")
  startsAt         DateTime?         @map("starts_at")
  endsAt           DateTime?         @map("ends_at")
  active           Boolean           @default(true)
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")

  location    Location?            @relation(fields: [locationId], references: [id])
  orders      Order[]
  redemptions DiscountRedemption[]

  @@unique([locationId, code])
  @@index([locationId])
  @@map("discount_codes")
}

model DiscountRedemption {
  id             String   @id
  discountCodeId String   @map("discount_code_id")
  orderId        String   @map("order_id")
  customerId     String?  @map("customer_id")
  locationId     String   @map("location_id")
  amountCents    Int      @map("amount_cents")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  discountCode DiscountCode @relation(fields: [discountCodeId], references: [id])
  order        Order        @relation(fields: [orderId], references: [id])
  customer     Customer?    @relation(fields: [customerId], references: [id])
  location     Location     @relation(fields: [locationId], references: [id])

  @@index([discountCodeId])
  @@index([orderId])
  @@index([customerId])
  @@index([locationId])
  @@map("discount_redemptions")
}

// ---------------------------------------------------------------------------
// Memberships
// ---------------------------------------------------------------------------

model MembershipPlan {
  id                   String          @id
  locationId           String          @map("location_id")
  name                 String
  priceCents           Int             @map("price_cents")
  interval             BillingInterval @default(MONTH)
  visitPolicy          VisitPolicy     @map("visit_policy")
  visitsPerPeriod      Int?            @map("visits_per_period")
  guestPassesPerPeriod Int             @default(0) @map("guest_passes_per_period")
  giftable             Boolean         @default(false)
  active               Boolean         @default(true)
  createdAt            DateTime        @default(now()) @map("created_at")
  updatedAt            DateTime        @updatedAt @map("updated_at")

  location      Location                 @relation(fields: [locationId], references: [id])
  subscriptions MembershipSubscription[]

  @@index([locationId])
  @@map("membership_plans")
}

model MembershipSubscription {
  id                     String             @id
  planId                 String             @map("plan_id")
  customerId             String             @map("customer_id")
  locationId             String             @map("location_id")
  status                 SubscriptionStatus
  currentPeriodStart     DateTime           @map("current_period_start")
  currentPeriodEnd       DateTime           @map("current_period_end")
  /// Day-of-month billing anchor (1–31)
  anchorDay              Int                @map("anchor_day")
  priceCentsOverride     Int?               @map("price_cents_override")
  stripePaymentMethodRef String?            @map("stripe_payment_method_ref")
  cancelAtPeriodEnd      Boolean            @default(false) @map("cancel_at_period_end")
  pausedUntil            DateTime?          @map("paused_until")
  giftedByCustomerId     String?            @map("gifted_by_customer_id")
  createdAt              DateTime           @default(now()) @map("created_at")
  updatedAt              DateTime           @updatedAt @map("updated_at")

  plan     MembershipPlan        @relation(fields: [planId], references: [id])
  customer Customer              @relation("CustomerSubscriptions", fields: [customerId], references: [id])
  location Location              @relation(fields: [locationId], references: [id])
  giftedBy Customer?             @relation("GiftedSubscriptions", fields: [giftedByCustomerId], references: [id])
  invoices SubscriptionInvoice[]

  @@index([planId])
  @@index([customerId])
  @@index([locationId])
  @@index([status, currentPeriodEnd])
  @@map("membership_subscriptions")
}

model SubscriptionInvoice {
  id             String        @id
  subscriptionId String        @map("subscription_id")
  locationId     String        @map("location_id")
  periodStart    DateTime      @map("period_start")
  periodEnd      DateTime      @map("period_end")
  orderId        String?       @map("order_id")
  attemptCount   Int           @default(0) @map("attempt_count")
  nextRetryAt    DateTime?     @map("next_retry_at")
  status         InvoiceStatus @default(PENDING)
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  subscription MembershipSubscription @relation(fields: [subscriptionId], references: [id])
  location     Location               @relation(fields: [locationId], references: [id])
  order        Order?                 @relation(fields: [orderId], references: [id])

  @@index([subscriptionId])
  @@index([locationId])
  @@index([status, nextRetryAt])
  @@map("subscription_invoices")
}

// ---------------------------------------------------------------------------
// Stored value: gift cards, packs, credits (append-only ledger)
// ---------------------------------------------------------------------------

model GiftCard {
  id                  String         @id
  locationId          String         @map("location_id")
  code                String         @unique
  initialCents        Int            @map("initial_cents")
  purchaserCustomerId String?        @map("purchaser_customer_id")
  recipientName       String?        @map("recipient_name")
  recipientContact    String?        @map("recipient_contact")
  status              GiftCardStatus @default(ACTIVE)
  createdAt           DateTime       @default(now()) @map("created_at")
  updatedAt           DateTime       @updatedAt @map("updated_at")

  location          Location            @relation(fields: [locationId], references: [id])
  purchaserCustomer Customer?           @relation(fields: [purchaserCustomerId], references: [id])
  ledgerEntries     StoredValueLedger[]

  @@index([locationId])
  @@map("gift_cards")
}

model Pack {
  id               String   @id
  locationId       String   @map("location_id")
  name             String
  credits          Int
  priceCents       Int      @map("price_cents")
  expiresAfterDays Int?     @map("expires_after_days")
  active           Boolean  @default(true)
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  location Location      @relation(fields: [locationId], references: [id])
  balances PackBalance[]

  @@index([locationId])
  @@map("packs")
}

model PackBalance {
  id         String    @id
  packId     String    @map("pack_id")
  customerId String    @map("customer_id")
  locationId String    @map("location_id")
  expiresAt  DateTime? @map("expires_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  pack          Pack                @relation(fields: [packId], references: [id])
  customer      Customer            @relation(fields: [customerId], references: [id])
  location      Location            @relation(fields: [locationId], references: [id])
  ledgerEntries StoredValueLedger[]

  @@index([packId])
  @@index([customerId])
  @@index([locationId])
  @@map("pack_balances")
}

/// Append-only. Balances are SUM(delta_cents) / SUM(delta_credits) — never mutable columns.
model StoredValueLedger {
  id            String       @id
  locationId    String       @map("location_id")
  giftCardId    String?      @map("gift_card_id")
  packBalanceId String?      @map("pack_balance_id")
  /// Set for account-credit entries
  customerId    String?      @map("customer_id")
  deltaCents    Int?         @map("delta_cents")
  deltaCredits  Int?         @map("delta_credits")
  reason        LedgerReason
  orderId       String?      @map("order_id")
  refundId      String?      @map("refund_id")
  note          String?
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  location    Location     @relation(fields: [locationId], references: [id])
  giftCard    GiftCard?    @relation(fields: [giftCardId], references: [id])
  packBalance PackBalance? @relation(fields: [packBalanceId], references: [id])
  customer    Customer?    @relation(fields: [customerId], references: [id])
  order       Order?       @relation(fields: [orderId], references: [id])
  refund      Refund?      @relation(fields: [refundId], references: [id])

  @@index([locationId])
  @@index([giftCardId])
  @@index([packBalanceId])
  @@index([customerId])
  @@index([orderId])
  @@map("stored_value_ledger")
}

// ---------------------------------------------------------------------------
// Staff
// ---------------------------------------------------------------------------

model StaffUser {
  id         String   @id
  name       String
  email      String   @unique
  phone      String?
  authUserId String?  @unique @map("auth_user_id")
  /// Hashed POS PIN — never store plaintext
  pin        String?
  active     Boolean  @default(true)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  roles            StaffRole[]
  refundsInitiated Refund[]

  @@map("staff_users")
}

model StaffRole {
  id          String        @id
  staffUserId String        @map("staff_user_id")
  role        StaffRoleKind
  /// null = org-wide role (CORPORATE_ADMIN). NULL-distinct caveat handled by a
  /// partial unique index in prisma/sql/constraints.sql.
  locationId  String?       @map("location_id")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  staffUser StaffUser @relation(fields: [staffUserId], references: [id])
  location  Location? @relation(fields: [locationId], references: [id])

  @@unique([staffUserId, role, locationId])
  @@index([staffUserId])
  @@index([locationId])
  @@map("staff_roles")
}

// ---------------------------------------------------------------------------
// Infrastructure: audit, webhooks, outbox
// ---------------------------------------------------------------------------

/// Append-only. Anything touching money or capacity writes a row here in the
/// same transaction. Intentionally no FKs so log writes can never be blocked
/// by (or block) domain-row lifecycles.
model AuditLog {
  id         String    @id
  actorType  ActorType @map("actor_type")
  actorId    String?   @map("actor_id")
  locationId String?   @map("location_id")
  action     String
  entityType String    @map("entity_type")
  entityId   String    @map("entity_id")
  before     Json?
  after      Json?
  ip         String?
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  @@index([locationId])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

model WebhookEvent {
  id              String        @id
  provider        String
  providerEventId String        @map("provider_event_id")
  type            String
  payload         Json
  status          WebhookStatus @default(RECEIVED)
  processedAt     DateTime?     @map("processed_at")
  error           String?
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  @@unique([provider, providerEventId])
  @@index([status])
  @@map("webhook_events")
}

/// Transactional notification outbox — rows are written in the same transaction
/// as the state change they announce, then drained by cron. No FK by design.
model OutboxMessage {
  id           String       @id
  locationId   String?      @map("location_id")
  kind         OutboxKind
  recipient    String
  template     String
  payload      Json
  scheduledFor DateTime     @map("scheduled_for")
  sentAt       DateTime?    @map("sent_at")
  status       OutboxStatus @default(PENDING)
  attempts     Int          @default(0)
  lastError    String?      @map("last_error")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  @@index([locationId])
  @@index([status, scheduledFor])
  @@map("outbox_messages")
}

// ── Better Auth storage ──────────────────────────────────────────────────────
// Owned by better-auth's prisma adapter (packages/api/src/auth.ts). Field names
// follow better-auth's defaults (plus the phone-number plugin's user fields);
// only table/column names are mapped to repo snake_case convention.

model AuthUser {
  id                  String    @id
  name                String
  email               String    @unique
  emailVerified       Boolean   @default(false) @map("email_verified")
  image               String?
  phoneNumber         String?   @unique @map("phone_number")
  phoneNumberVerified Boolean?  @map("phone_number_verified")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")
  sessions            AuthSession[]
  accounts            AuthAccount[]

  @@map("auth_users")
}

model AuthSession {
  id        String   @id
  userId    String   @map("user_id")
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  user      AuthUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("auth_sessions")
}

model AuthAccount {
  id           String    @id
  userId       String    @map("user_id")
  accountId    String    @map("account_id")
  providerId   String    @map("provider_id")
  accessToken  String?   @map("access_token")
  refreshToken String?   @map("refresh_token")
  idToken      String?   @map("id_token")
  scope        String?
  password     String?
  expiresAt    DateTime? @map("expires_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  user         AuthUser  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("auth_accounts")
}

model AuthVerification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([identifier])
  @@map("auth_verifications")
}
